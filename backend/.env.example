NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/court_case_management
# Generate each secret independently with: openssl rand -base64 48
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
REFRESH_SECRET=replace_with_another_unique_random_secret_at_least_32_chars
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Required only when running the explicit seed command
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_chars
